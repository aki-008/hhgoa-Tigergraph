# TigerGraph connection — copy to .env and fill in (Savanna example)
# .env is gitignored, safe for secrets. MCP server loads this automatically.

# Savanna: https://<your-workspace>.i.tgcloud.io  (find in Savanna workspace > Connection)
TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPHNAME=HHGOA_Fraud
TG_USERNAME=tigergraph
# Savanna/cloud instances authenticate with a secret, not a password.
# Create one in Savanna (workspace > secrets) and put it here:
TG_SECRET=change-me
# Required for Savanna / any TGCloud instance:
TG_TGCLOUD=true

# Ports — leave defaults for Savanna (9000/14240 are ignored when TGCLOUD=true,
# but harmless to keep):
TG_RESTPP_PORT=9000
TG_GS_PORT=14240

# Optional: use token auth instead of user/pass (uncomment if you have one)
# TG_API_TOKEN=your_api_token_here

# Optional: restrict tools served to agent (read-only is safest for investigation)
# TG_ALLOWED_TOOLS=read-only
# TG_LOG_TOOL_CALLS=true

# Optional: LLM path (scripts/llm_investigate.py). Local OpenAI-compatible server:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:32b
# LLM_API_KEY=ollama
# LLM_TIMEOUT_S=600
# ...or Groq (takes precedence when set):
# GROQ_API_KEY=gsk_change-me
# GROQ_MODEL=qwen/qwen3.8-27b
